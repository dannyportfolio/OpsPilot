# ==============================================================================
# OpsPilot Environment Configuration Reference
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT:
#   cp .env.example .env
#
# NEVER COMMIT .env OR REAL SECRETS TO VERSION CONTROL!
# All sensitive production secrets should be managed via AWS Secrets Manager,
# AWS Systems Manager Parameter Store, or your CI/CD environment.
# ==============================================================================

# Server Network Configuration (Local HTTP Server)
# Port number the local server listens on.
PORT=8080

# Storage Driver Selection
# Supported options:
#   - memory: In-memory store (volatile, resets on process restart, no external dependencies)
#   - postgres: PostgreSQL persistence adapter using schema migrations
STORAGE_DRIVER=memory

# PostgreSQL Database Connection String
# Required when STORAGE_DRIVER=postgres.
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=<sslmode>
# For local Docker Compose setup:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opspilot?sslmode=disable

# Structured Logging Configuration
# Supported levels: DEBUG, INFO, WARN, ERROR
# Outputs structured JSON to stdout.
LOG_LEVEL=INFO

# Authentication & Security
# HMAC-SHA256 signing secret for JWT access tokens.
# MUST be at least 16 bytes (recommended 32+ random alphanumeric/hex characters).
# WARNING: Replace with a cryptographically secure random secret in production!
AUTH_JWT_SECRET=dev-secret-do-not-use-in-production-32-bytes-minimum

# Token Lifespan (in seconds)
# Default: 3600 (1 hour). For high-security environments, consider 900 (15 minutes).
AUTH_TOKEN_TTL_SECONDS=3600
